{
  "cleanUrls": true,
  "redirects": [
    { "source": "/Abdullah_Baleid's_CV.pdf", "destination": "/assets/cv/Abdullah_Baleid_CV.pdf", "permanent": true },
    { "source": "/Abdullah_Baleid%27s_CV.pdf", "destination": "/assets/cv/Abdullah_Baleid_CV.pdf", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
